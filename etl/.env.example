# Copy this file to .env (same folder) and fill in the same values you use in Power BI's parameters.
# .env stays on your computer; it is never uploaded to the dashboard.

DAYS_BACK=60

# Shopify custom apps (Power BI: ClientId/ClientSecret, OR_ClientId/OR_ClientSecret, OZ_ClientId/OZ_ClientSecret)
SHOPIFY_DALYDRESS_CLIENT_ID=
SHOPIFY_DALYDRESS_CLIENT_SECRET=
SHOPIFY_OR_CLIENT_ID=
SHOPIFY_OR_CLIENT_SECRET=
SHOPIFY_OZ_CLIENT_ID=
SHOPIFY_OZ_CLIENT_SECRET=

# Bosta API keys (Power BI: BostaApiKey, OR_BostaApiKey, OZ_BostaApiKey)
BOSTA_DALYDRESS_API_KEY=
BOSTA_OR_API_KEY=
BOSTA_OZ_API_KEY=

# Mylerz login (Power BI: MylerzUser, MylerzPassword)
MYLERZ_USER=
MYLERZ_PASSWORD=

# Daniel Hechter (Power BI: DH_ClientId, DH_ClientSecret, DH_BostaApiKey). Leave empty to skip this brand.
SHOPIFY_DH_CLIENT_ID=
SHOPIFY_DH_CLIENT_SECRET=
BOSTA_DH_API_KEY=

# E-stebdal returns, brand OR (Power BI: EstebdalApiKey). Leave empty to skip the Returns page data.
ESTEBDAL_API_KEY=
